@page
@model SchoolManagementSystem.Api.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Iniciar sesión";
}
<!doctype html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <style>
        :root { color-scheme: light; font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; color: #18233d; background: #f2f5fb; }
        * { box-sizing: border-box; }
        body { min-height: 100vh; display: grid; place-items: center; margin: 0; padding: 24px; background: radial-gradient(ellipse at 12% 8%, rgba(143, 197, 255, .24), transparent 36%), linear-gradient(140deg, #f6f8fc, #eef2f9); }
        main { width: min(100%, 460px); padding: clamp(26px, 6vw, 44px); border: 1px solid #e1e7f0; border-radius: 22px; background: #fff; box-shadow: 0 24px 70px rgba(23, 40, 95, .13); }
        .brand { display: flex; align-items: center; gap: 11px; margin-bottom: 34px; color: #16244b; font-weight: 800; }
        .brand-mark { width: 42px; height: 42px; display: grid; place-items: center; border-radius: 13px; background: #3154b5; color: white; font-size: 1.15rem; }
        .eyebrow { margin: 0 0 9px; color: #9d3947; font-size: .76rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
        h1 { margin: 0; color: #16244b; font-size: clamp(1.8rem, 6vw, 2.2rem); line-height: 1.15; letter-spacing: -.04em; }
        .description { margin: 13px 0 25px; color: #68748c; line-height: 1.6; }
        label { display: block; margin: 18px 0 7px; color: #26334f; font-size: .88rem; font-weight: 700; }
        input[type="email"], input[type="password"], input[type="text"] { width: 100%; min-height: 48px; padding: 11px 13px; border: 1px solid #cfd7e5; border-radius: 10px; background: #fff; color: #18233d; font: inherit; }
        input:focus-visible, button:focus-visible { outline: 3px solid rgba(49, 84, 181, .32); outline-offset: 2px; border-color: #3154b5; }
        .password-field { display: flex; align-items: stretch; gap: 8px; }
        .password-field input { min-width: 0; flex: 1; }
        .toggle-password { flex: 0 0 auto; padding: 0 12px; border: 1px solid #cfd7e5; border-radius: 10px; background: white; color: #3154b5; font: inherit; font-size: .82rem; font-weight: 700; cursor: pointer; }
        .remember { display: flex; align-items: center; gap: 9px; margin: 17px 0 22px; color: #4f5d75; font-size: .88rem; font-weight: 500; }
        .remember input { width: 18px; height: 18px; margin: 0; accent-color: #3154b5; }
        .submit { width: 100%; min-height: 50px; padding: 11px 16px; border: 0; border-radius: 11px; background: #3154b5; color: white; font: inherit; font-weight: 750; cursor: pointer; }
        .submit:hover:not(:disabled) { background: #203a83; }
        .submit:disabled { cursor: wait; opacity: .75; }
        .error { margin: 14px 0; padding: 12px 14px; border-radius: 10px; background: #fff0f0; color: #9f2938; line-height: 1.45; }
        .validation-summary-valid { display: none; }
        @@media (max-width: 420px) { body { padding: 14px; } main { border-radius: 17px; } .password-field { flex-wrap: wrap; } .toggle-password { min-height: 42px; } }
    </style>
</head>
<body>
    <main>
        <div class="brand"><span class="brand-mark" aria-hidden="true">S</span><span>School Management System</span></div>
        <p class="eyebrow">Acceso institucional</p>
        <h1>Iniciar sesión</h1>
        <p>Ingresá con la cuenta que te proporcionó la administración de la escuela.</p>
        <form id="login-form" method="post" asp-page="/Account/Login">
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="error" role="alert"></div>
            <label asp-for="Input.Email">Correo electrónico</label>
            <input asp-for="Input.Email" type="email" autocomplete="username" required />
            <label asp-for="Input.Password">Contraseña</label>
            <div class="password-field">
                <input asp-for="Input.Password" type="password" autocomplete="current-password" required />
                <button class="toggle-password" id="toggle-password" type="button" aria-controls="Input_Password" aria-pressed="false">Mostrar</button>
            </div>
            <label><input asp-for="Input.RememberMe" type="checkbox" /> Mantener sesión iniciada</label>
            <button class="submit" id="submit-button" type="submit">Ingresar</button>
        </form>
    </main>
    <script>
        const passwordInput = document.getElementById("Input_Password");
        const togglePassword = document.getElementById("toggle-password");
        togglePassword.addEventListener("click", () => {
            const showing = passwordInput.type === "password";
            passwordInput.type = showing ? "text" : "password";
            togglePassword.textContent = showing ? "Ocultar" : "Mostrar";
            togglePassword.setAttribute("aria-pressed", String(showing));
        });

        document.getElementById("login-form").addEventListener("submit", () => {
            const submitButton = document.getElementById("submit-button");
            submitButton.disabled = true;
            submitButton.textContent = "Ingresando…";
            submitButton.setAttribute("aria-busy", "true");
        });
    </script>
</body>
</html>
